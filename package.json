{
  "name": "@notyourapple/telegram-stars",
  "version": "0.1.0",
  "description": "Production-ready, zero-dependency TypeScript SDK for Telegram Stars payments, balances, transactions, refunds, and subscriptions.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint src tests examples",
    "lint:fix": "eslint src tests examples --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"examples/**/*.ts\" \"*.json\" \"*.md\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"examples/**/*.ts\" \"*.json\" \"*.md\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Notyourapple/telegram-stars-sdk.git"
  },
  "keywords": [
    "telegram",
    "telegram-stars",
    "telegram-bot",
    "payments",
    "xtr",
    "telegram-api",
    "typescript",
    "sdk"
  ],
  "author": "Notyourapple",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Notyourapple/telegram-stars-sdk/issues"
  },
  "homepage": "https://github.com/Notyourapple/telegram-stars-sdk#readme",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/node": "^22.13.4",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.20.1",
    "prettier": "^3.5.1",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vitest": "^3.0.5"
  }
}
